{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@screencold/db": ["../../packages/db/src"],
      "@screencold/types": ["../../packages/types/src"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*", "lib/**/*"],
  "exclude": ["node_modules", "dist"]
}