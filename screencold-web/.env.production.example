# =============================================
# SCREENCOLD-WEB - Production Environment
# =============================================
# This file is for production defaults
# Sensitive values should be in .env.production.local

# =============================================
# DATABASE
# =============================================
DATABASE_URL="postgresql://screencold:CHANGE_IN_PRODUCTION_LOCAL@localhost:5432/screencold?schema=public"

# =============================================
# REDIS
# =============================================
REDIS_URL="redis://localhost:6379"

# =============================================
# NEXTAUTH
# =============================================
NEXTAUTH_URL="https://app.screencold.com"
NEXTAUTH_SECRET="CHANGE_IN_PRODUCTION_LOCAL"

# =============================================
# GOOGLE OAUTH
# =============================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================
# ANTHROPIC
# =============================================
ANTHROPIC_API_KEY=""

# =============================================
# AWS S3
# =============================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
AWS_S3_BUCKET="screencold-screenshots"
AWS_S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"

# =============================================
# STRIPE
# =============================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
STRIPE_AGENCY_PRICE_ID=""

# =============================================
# EMAIL
# =============================================
RESEND_API_KEY=""
FROM_EMAIL="ScreenCold <noreply@screencold.com>"

# =============================================
# SENTRY
# =============================================
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="screencold"
SENTRY_PROJECT="screencold-web"

# =============================================
# APPLICATION
# =============================================
NEXT_PUBLIC_APP_URL="https://app.screencold.com"

# =============================================
# NODE ENVIRONMENT
# =============================================
NODE_ENV="production"