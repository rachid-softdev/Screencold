# =============================================
# SCREENCOLD-WEB - Environment Variables
# =============================================
# Copy this file to .env.local for local overrides
# DO NOT commit .env.local or .env*.local files

# =============================================
# DATABASE
# =============================================
DATABASE_URL="postgresql://screencold:screencold_dev_password@localhost:5432/screencold?schema=public"

# =============================================
# REDIS
# =============================================
REDIS_URL="redis://localhost:6379"

# =============================================
# NEXTAUTH (Authentication)
# =============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"

# =============================================
# GOOGLE OAUTH
# =============================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================
# ANTHROPIC (AI)
# =============================================
ANTHROPIC_API_KEY=""

# =============================================
# AWS S3 (File Storage)
# =============================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
AWS_S3_BUCKET="screencold-screenshots"
AWS_S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"

# =============================================
# STRIPE (Payments)
# =============================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
STRIPE_AGENCY_PRICE_ID=""

# =============================================
# EMAIL (Resend)
# =============================================
RESEND_API_KEY=""
FROM_EMAIL="ScreenCold <noreply@screencold.com>"

# =============================================
# SENTRY (Monitoring)
# =============================================
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="screencold"
SENTRY_PROJECT="screencold-web"

# =============================================
# APPLICATION
# =============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================
# PLAYWRIGHT
# =============================================
PLAYWRIGHT_BROWSERS_PATH="/ms-playwright"

# =============================================
# NODE ENVIRONMENT
# =============================================
NODE_ENV="development"