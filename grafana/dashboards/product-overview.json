{
  "title": "ScreenCold - Product Overview",
  "version": 1,
  "panels": [
    {
      "title": "Active Users",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "count(sc_users_total)", "legendFormat": "Active Users" }],
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 }
    },
    {
      "title": "Audits Created (24h)",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(sc_audits_created_total[24h]))", "legendFormat": "Audits" }],
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 0 }
    },
    {
      "title": "Jobs Processed (24h)",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(sc_jobs_completed_total[24h]))", "legendFormat": "Jobs" }],
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 0 }
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(sc_errors_total[5m])) / sum(rate(sc_requests_total[5m])) * 100", "legendFormat": "Error Rate" }],
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 0 }
    },
    {
      "title": "API Latency P99",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(sc_api_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "title": "Queue Depth",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sc_queue_depth", "legendFormat": "{{queue}}" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    }
  ]
}
