{
  "name": "screencold",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "turbo run build",
    "build:analyze": "ANALYZE=true pnpm build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @screencold/db generate",
    "db:push": "pnpm --filter @screencold/db push",
    "db:migrate": "pnpm --filter @screencold/db migrate",
    "db:studio": "pnpm --filter @screencold/db studio",
    "db:seed": "pnpm --filter @screencold/db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "prepare": "husky install",
    "web:dev": "pnpm --filter @screencold/web dev",
    "web:build": "pnpm --filter @screencold/web build",
    "web:start": "pnpm --filter @screencold/web start",
    "web:test": "pnpm --filter @screencold/web test",
    "web:lint": "pnpm --filter @screencold/web lint",
    "web:typecheck": "pnpm --filter @screencold/web typecheck",
    "desktop:dev": "pnpm --filter @screencold/desktop dev",
    "desktop:build": "pnpm --filter @screencold/desktop build",
    "desktop:test": "pnpm --filter @screencold/desktop test",
    "desktop:lint": "pnpm --filter @screencold/desktop lint",
    "desktop:typecheck": "pnpm --filter @screencold/desktop typecheck",
    "mobile:dev": "pnpm --filter @screencold/mobile dev",
    "mobile:build": "pnpm --filter @screencold/mobile build",
    "mobile:test": "pnpm --filter @screencold/mobile test",
    "mobile:lint": "pnpm --filter @screencold/mobile lint",
    "mobile:typecheck": "pnpm --filter @screencold/mobile typecheck",
    "extension:dev": "pnpm --filter @screencold/extension dev",
    "extension:build": "pnpm --filter @screencold/extension build",
    "extension:test": "pnpm --filter @screencold/extension test",
    "extension:lint": "pnpm --filter @screencold/extension lint",
    "extension:typecheck": "pnpm --filter @screencold/extension typecheck",
    "check-env": "pnpm --filter @screencold/web check-env",
    "push-env": "pnpm --filter @screencold/web push-env"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageExtensions": {
    "@next/env": {
      "external": true
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{js,json,md}": ["prettier --write"],
    "*.prisma": ["prisma format"]
  }
}
