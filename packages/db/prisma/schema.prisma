generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication (NextAuth.js)
// ============================================

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  password             String?
  image                String?
  plan                 Plan      @default(FREE)
  // NOTE: A `CHECK (credits >= 0)` constraint must be added via a raw SQL migration.
  // Prisma does not natively support CHECK constraints.
  // Migration SQL: ALTER TABLE "User" ADD CONSTRAINT "credits_non_negative" CHECK (credits >= 0);
  credits              Int       @default(5)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  creditsResetsAt      DateTime?
  googleId             String?   @unique
  emailVerified        DateTime?
  role                 Role      @default(USER)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  accounts             Account[]
  sessions             Session[]
  campaigns            Campaign[]
  audits               Audit[]
  creditTransactions   CreditTransaction[]
  userRoles            UserRole[]
  notifications        Notification[]
  auditEvents          AuditEvent[]
  apiKeys              ApiKey[]
  teams                Team[]          // as owner
  teamMemberships      TeamMember[]
  emailTemplates       EmailTemplate[]
  sentEmails           SentEmail[]
  userIntegrations     UserIntegration[]

  @@index([email])
  @@index([stripeCustomerId])
  @@index([googleId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

// NextAuth Adapters
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token     String? @db.Text
  expires_at       Int?
  token_type       String?
  scope            String?
  id_token         String? @db.Text
  session_state    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Campaigns & Prospects
// ============================================

model Campaign {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectsList Prospect[]

  @@index([userId])
}

enum ProspectStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Prospect {
  id           String         @id @default(cuid())
  url          String
  companyName  String?
  contactName  String?
  contactEmail String?
  notes        String?
  campaignId   String
  status       ProspectStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  audit    Audit?

  @@unique([campaignId, url])
  @@index([campaignId])
  @@index([status])
}

// ============================================
// Audits
// ============================================

enum AuditStatus {
  PROCESSING
  READY
  FAILED
}

model Audit {
  id             String      @id @default(cuid())
  prospectId     String      @unique
  userId         String
  screenshotUrl  String?
  annotatedUrl   String?
  mobileUrl      String?
  issues         Json?
  siteType       String?
  overallScore   Int?
  emailSubject   String?
  emailBody      String?     @db.Text
  emailPs        String?
  status         AuditStatus @default(PROCESSING)
  errorMessage   String?
  processingTime Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  prospect          Prospect           @relation(fields: [prospectId], references: [id])
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditTransaction CreditTransaction?
  sentEmails        SentEmail[]

  @@index([userId])
  @@index([status])
}

// ============================================
// Credit Transactions
// ============================================

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  type      String
  auditId   String?  @unique
  createdAt DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  audit Audit? @relation(fields: [auditId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
}

// ============================================
// Notifications
// ============================================

enum NotificationType {
  AUDIT_COMPLETE
  AUDIT_FAILED
  CREDITS_LOW
  SUBSCRIPTION_EXPIRED
  NEW_FEATURE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

// ============================================
// Audit Events (Security & Compliance)
// ============================================

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  PLAN_CHANGE
  CREDIT_PURCHASE
  AUDIT_CREATED
  AUDIT_COMPLETED
  AUDIT_FAILED
  CAMPAIGN_CREATED
  CSV_IMPORTED
  DATA_EXPORT
  ACCOUNT_DELETE
  SETTINGS_UPDATE
}

model AuditEvent {
  id        String       @id @default(cuid())
  userId    String
  action    AuditAction
  resource  String?
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime     @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// API Keys (for Pro & Agency plans)
// ============================================

model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique // Hashed key
  keyPrefix   String    // First 8 chars for display (ex: sk_live_xxxx)
  name        String
  userId      String
  plan        Plan      @default(FREE)
  rateLimit   Int       @default(100) // req/min
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

// ============================================
// Team Management
// ============================================

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(FREE)
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invitations TeamInvitation[]

  @@index([ownerId])
}

model TeamMember {
  id        String    @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole  @default(MEMBER)
  joinedAt  DateTime  @default(now())

  // Relations
  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvitation {
  id        String    @id @default(cuid())
  teamId    String
  email     String
  role      TeamRole  @default(MEMBER)
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
}

// ============================================
// Email Templates
// ============================================

model EmailTemplate {
  id          String    @id @default(cuid())
  name        String
  description String?
  subject     String    // Template de sujet avec variables
  body        String    @db.Text // Template de corps avec variables
  variables   Json      // ["contactName", "companyName", "score", etc.]
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  userId      String?   // Null = template global
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum SentEmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

model SentEmail {
  id          String           @id @default(cuid())
  auditId     String
  userId      String
  to          String
  subject     String
  body        String           @db.Text
  status      SentEmailStatus  @default(PENDING)
  messageId   String?          // Resend message ID
  sentAt      DateTime         @default(now())
  createdAt   DateTime         @default(now())

  // Relations
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([sentAt])
}

// ============================================
// User Integrations (Gmail, etc.)
// ============================================

enum IntegrationType {
  GMAIL
  GOOGLE_DRIVE
  SLACK
  ZAPIER
}

enum IntegrationStatus {
  ACTIVE
  ERROR
  EXPIRED
}

model UserIntegration {
  id          String            @id @default(cuid())
  userId      String
  type        IntegrationType
  status      IntegrationStatus @default(ACTIVE)
  tokens      Json              // Encrypted tokens (access, refresh, etc.)
  expiresAt   DateTime?
  settings    Json?            // Additional settings
  lastSyncAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// ============================================
// Feature Flags & Entitlements System
// ============================================

// Feature type enum
enum FeatureType {
  BOOLEAN   // true/false feature flag
  LIMIT     // numeric quota
  EXPERIMENT // A/B test experiment
}

// Downgrade strategy enum
enum DowngradeStrategy {
  GRACEFUL  // Keep access until period_end, then cut
  IMMEDIATE // Cut access immediately on webhook
  FREEZE    // Block new actions, keep existing data
}

// Plan configuration
model PlanConfig {
  id            String   @id @default(cuid())
  key           String   @unique // FREE, STARTER, PRO, AGENCY
  name          String
  priceMonthly  Decimal  @db.Decimal(10, 2)
  priceYearly   Decimal? @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  features PlanFeature[]

  @@index([isActive])
  @@index([key])
}

// Feature definition
model Feature {
  id              String       @id @default(cuid())
  key             String       @unique // EXPORT_PDF, AI_SUMMARY, etc.
  description     String?
  type            FeatureType  @default(BOOLEAN)
  defaultConfig   Json?        // Default configuration for the feature
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  planFeatures PlanFeature[]

  @@index([isActive])
  @@index([key])
}

// Plan-Feature mapping with specific configuration
model PlanFeature {
  id              String           @id @default(cuid())
  planId          String
  featureId       String
  enabled         Boolean          @default(false)
  limitValue      Int?             // For LIMIT type features (-1 = unlimited)
  configJson      Json?            // Additional config (e.g., experiment percentage)
  downgradeStrategy DowngradeStrategy @default(GRACEFUL)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  plan    PlanConfig @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
}

// Organization (maps to Team for now, can be extended)
model Organization {
  id                String   @id @default(cuid())
  name              String
  stripeCustomerId  String?  @unique
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  subscriptions        Subscription[]
  entitlementOverrides EntitlementOverride[]
  usageTrackings      UsageTracking[]

  @@index([stripeCustomerId])
  @@index([isActive])
}

// Subscription with billing period tracking
model Subscription {
  id                   String    @id @default(cuid())
  orgId                String
  planKey              String    @default("FREE")
  status               String    @default("inactive") // active, trialing, past_due, canceled
  stripeSubId          String?   @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
  @@index([stripeSubId])
}

// Entitlement overrides (user or org level)
enum OverrideScope {
  USER
  ORG
}

model EntitlementOverride {
  id             String         @id @default(cuid())
  scope          OverrideScope // user or org
  scopeId        String         // userId or orgId
  featureKey     String
  enabled        Boolean        @default(false)
  limitValue     Int?
  expiresAt      DateTime?
  reason         String?        // Required for audit
  createdBy      String?        // admin user id
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  Organization   Organization?  @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@unique([scope, scopeId, featureKey])
  @@index([scope, scopeId])
  @@index([featureKey])
  @@index([expiresAt])
}

// Usage tracking for limit features
model UsageTracking {
  id            String    @id @default(cuid())
  orgId         String
  featureKey    String
  usageCount    Int       @default(0)
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, featureKey, periodStart])
  @@index([orgId, featureKey])
  @@index([periodEnd])
}

// ============================================
// Job Tracking for Worker Idempotency
// ============================================

enum JobStepStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model JobTracking {
  id        String         @id @default(cuid())
  jobId     String
  auditId   String
  step      String         // 'capture', 'analyze', 'annotate'
  status    JobStepStatus  @default(PENDING)
  result    Json?
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([jobId, auditId, step])
  @@index([status])
  @@index([auditId])
  @@index([jobId])
}

// Stripe webhook event log for idempotency
model StripeEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique // Stripe event ID
  type      String
  data      Json     // Full event payload
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([processed])
  @@index([eventId])
}

// User-Organization mapping (for user-based entitlements)
model UserOrganization {
  id          String   @id @default(cuid())
  userId      String
  orgId       String
  role        String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
}
