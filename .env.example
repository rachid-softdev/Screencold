# Database
DATABASE_URL="postgresql://screencold:screencold_dev_password@localhost:5432/screencold?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Anthropic (AI)
ANTHROPIC_API_KEY="sk-ant-..."

# AWS S3
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="eu-west-1"
AWS_S3_BUCKET="screencold-screenshots"
AWS_S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_STARTER_PRICE_ID="price_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_AGENCY_PRICE_ID="price_..."

# Email (Resend)
RESEND_API_KEY="re_..."
FROM_EMAIL="ScreenCold <noreply@screencold.com>"

# Sentry (Monitoring)
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"
SENTRY_AUTH_TOKEN="sntrys_..."
SENTRY_ORG="screencold"
SENTRY_PROJECT="screencold-web"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Playwright
PLAYWRIGHT_BROWSERS_PATH="/ms-playwright"

# Node Environment
NODE_ENV="development"
